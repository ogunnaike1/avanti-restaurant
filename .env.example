# Where reservation emails are delivered — the restaurant's mailbox.
RESERVATIONS_EMAIL=reservations@avanti.ng

# SMTP credentials from whoever hosts that mailbox (Google Workspace, Zoho,
# cPanel, Namecheap …). With these unset the site still records bookings to
# .data/reservations.json and logs that no mail was sent.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=reservations@avanti.ng
SMTP_PASS=your-app-password
# Optional: 465 implies TLS, 587 uses STARTTLS. Override only if your host differs.
# SMTP_SECURE=false
# Optional: must usually be an address your SMTP account is allowed to send as.
# SMTP_FROM=AVANTI Reservations <reservations@avanti.ng>
